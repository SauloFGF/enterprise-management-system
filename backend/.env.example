# ============================================
# Enterprise Management System — Backend
# Example environment configuration
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file with real secrets.
# ============================================

# --- Database (PostgreSQL) ---
# Used when no user secret or environment variable is set.
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=enterprise_management;Username=postgres;Password=your_password_here

# --- JWT ---
# Minimum 32 bytes (256 bits) for HS256.
# Generate a strong random key for production.
Jwt__Key=your-32-byte-minimum-signing-key-here

# --- CORS ---
# Comma-separated list of allowed origins for production.
# Leave empty to use appsettings.Production.json default.
FRONTEND_ORIGIN=https://your-production-domain.com

# --- Admin Seed (Development/Test only) ---
# Used by UserSeed to create the initial admin user.
# NEVER set these in production.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=ChangeMe123!
